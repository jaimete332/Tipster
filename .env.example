# Copia este archivo a .env (nunca lo subas al repositorio) o usa la pantalla Configuración.
# Las variables de entorno tienen prioridad sobre las claves guardadas desde la interfaz.
# The Odds API: casas de referencia (Pinnacle y ~25 casas europeas)
THE_ODDS_API_KEY=
# Betfair Exchange España (API oficial): Application Key + usuario y contraseña de betfair.es
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Matchbook: la lectura de precios no necesita credenciales
# Puerto y host (por defecto sólo escucha en local)
PORT=8787
HOST=127.0.0.1
